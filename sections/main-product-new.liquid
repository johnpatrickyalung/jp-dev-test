<section
  id="MainProductSwiper-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  {{ 'section-main-product-new.css' | asset_url | stylesheet_tag }}
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    media="print"
    onload="this.media='all'"
  >
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (max-width: 768px) {
      .section-{{ section.id }}-padding {
        padding-top: 20px;
      }
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    #VideoTestimonials-{{ section.id }} {
      margin-top: {{ section.settings.video_testimonials_margin_top | default: 32 }}px;
      margin-bottom: {{ section.settings.video_testimonials_margin_bottom | default: 32 }}px;
    }

    {%- for block in section.blocks -%}
      {%- liquid
        assign block_margin_top = block.settings.margin_top
        assign block_margin_bottom = block.settings.margin_bottom

        if block.type == '@app'
          if block_margin_top == blank
            assign block_margin_top = 16
          endif
          if block_margin_bottom == blank
            assign block_margin_bottom = 16
          endif
        endif
      -%}
      #ProductBlock-{{ block.id }} {
        margin-top: {{ block_margin_top | default: 0 }}px;
        margin-bottom: {{ block_margin_bottom | default: 0 }}px;
      }
    {%- endfor -%}
  {%- endstyle -%}

  <script src="{{ 'product-bundle-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'selling-plans.js' | asset_url }}" defer="defer"></script>
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
  <script src="{{ 'product-swiper-gallery.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-video-testimonials.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-accordion.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-ingredients-modal.js' | asset_url }}" defer="defer"></script>

  <div class="product-swiper-layout">
    <div class="product-swiper-layout__gallery{% if section.settings.enable_sticky_gallery %} product-swiper-layout__gallery--sticky{% endif %}">
      {% render 'product-swiper-gallery', section: section, product: product %}

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
      {%- if accordion_blocks.size > 0 -%}
        <div class="product-swiper-accordions desktop-only">
          {%- for block in accordion_blocks -%}
            {% render 'product-accordion', block: block, section: section %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-swiper-layout__info">
      {%- assign video_testimonials_rendered = false -%}
      {%- assign mobile_accordions_rendered = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          {%- continue -%}
        {%- endif -%}
        {%- if block.type == 'video_testimonial' -%}
          {%- unless video_testimonials_rendered -%}
            <div id="VideoTestimonials-{{ section.id }}" class="product-swiper-layout__block product-video-testimonials-wrap">
              {% render 'product-video-testimonials', section: section %}
            </div>
            {%- assign video_testimonials_rendered = true -%}
          {%- endunless -%}
          {%- continue -%}
        {%- endif -%}
        <div id="ProductBlock-{{ block.id }}" class="product-swiper-layout__block" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'trust_rating' -%}
              {% render 'product-trust-rating', block: block %}
            {%- when 'subheading' -%}
              {% render 'product-subheading', block: block, product: product %}
            {%- when 'title' -%}
              {% render 'product-title', block: block, product: product %}
            {%- when 'description' -%}
              {% render 'product-description', block: block, product: product %}
            {%- when 'benefits_list' -%}
              {% render 'product-benefits-list', block: block %}
            {%- when 'variants' -%}
              {% render 'product-bundle-variants', block: block, product: product, section: section %}
            {%- when 'subscription_banner' -%}
              {% render 'product-subscription-banner', block: block, product: product, section: section %}
            {%- when 'add_to_cart' -%}
              {% render 'product-add-to-cart', block: block, product: product, section: section, product_form_id: product_form_id %}
            {%- when 'info_list' -%}
              {% render 'product-info-list', block: block, product: product %}
              {%- unless mobile_accordions_rendered -%}
                {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
                {%- if accordion_blocks.size > 0 -%}
                  <div class="product-swiper-accordions mobile-only">
                    {%- for accordion_block in accordion_blocks -%}
                      <div id="ProductBlock-{{ accordion_block.id }}" class="product-swiper-layout__block" {{ accordion_block.shopify_attributes }}>
                        {% render 'product-accordion', block: accordion_block, section: section %}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                {%- assign mobile_accordions_rendered = true -%}
              {%- endunless -%}
            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

</section>

