{% comment %}
  Renders bundle-style variant picker cards.

  Accepts:
  - block: {Object}
  - product: {Object}
  - section: {Object}

  Usage:
  {% render 'product-bundle-variants', block: block, product: product, section: section %}
{% endcomment %}

{%- liquid
  assign default_option = block.settings.default_option | default: 1 | plus: 0
  assign fixed_selling_plan_id = ''
  assign dummy_subscription_enabled = false
  assign dummy_subscription_percent = 20

  for section_block in section.blocks
    if section_block.type == 'subscription_banner'
      assign fixed_selling_plan_id = section_block.settings.selling_plan_id | strip
      if section_block.settings.use_dummy_subscription
        assign dummy_subscription_enabled = true
      endif
      assign dummy_subscription_percent = section_block.settings.save_percent | default: 20 | plus: 0
      break
    endif
  endfor
-%}

<bundle-variant-picker
  class="product-bundle-picker"
  data-section="{{ section.id }}"
  style="
    --bundle-heading-color: {{ block.settings.heading_color }};
    --bundle-accent-color: {{ block.settings.accent_color }};
    --bundle-selected-bg: {{ block.settings.selected_background_color }};
    --bundle-selected-border: {{ block.settings.selected_border_color }};
    --bundle-border-color: {{ block.settings.border_color }};
    --bundle-banner-bg: {{ block.settings.banner_background_color }};
    --bundle-badge-bg: {{ block.settings.badge_background_color }};
  "
>
  {%- if block.settings.heading != blank -%}
    <h2 class="product-bundle-picker__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="product-bundle-picker__options" role="radiogroup" aria-label="{{ block.settings.heading | escape }}">
    {%- for i in (1..3) -%}
      {%- liquid
        assign enabled_key = 'option_' | append: i | append: '_enabled'
        assign position_key = 'option_' | append: i | append: '_variant_position'
        assign image_key = 'option_' | append: i | append: '_image'
        assign title_key = 'option_' | append: i | append: '_title'
        assign highlight_key = 'option_' | append: i | append: '_highlight'
        assign bottle_count_key = 'option_' | append: i | append: '_bottle_count'
        assign save_badge_key = 'option_' | append: i | append: '_save_badge'
        assign customer_banner_key = 'option_' | append: i | append: '_customer_banner'
        assign best_value_key = 'option_' | append: i | append: '_best_value'

        assign option_enabled = block.settings[enabled_key]
        assign variant_position = block.settings[position_key] | default: i | plus: 0
        assign option_variant = nil
        assign variant_loop_index = 0

        for variant in product.variants
          assign variant_loop_index = variant_loop_index | plus: 1
          if variant_loop_index == variant_position
            assign option_variant = variant
            break
          endif
        endfor
      -%}

      {%- if option_enabled and option_variant -%}
        {%- liquid
          assign option_title = block.settings[title_key]
          if option_title == blank
            assign option_title = option_variant.title
          endif

          assign highlight_text = block.settings[highlight_key]
          assign bottle_count = block.settings[bottle_count_key] | default: 1
          if bottle_count == 0
            assign bottle_count = 1
          endif
          assign save_badge = block.settings[save_badge_key]
          assign customer_banner = block.settings[customer_banner_key]
          assign show_best_value = block.settings[best_value_key]

          assign option_price = option_variant.price
          assign option_compare = option_variant.compare_at_price | default: 0
          assign bottle_half = bottle_count | divided_by: 2
          assign per_bottle_price = option_price | plus: bottle_half | divided_by: bottle_count

          assign subscription_price = option_price
          assign first_selling_plan_id = ''
          assign has_real_allocation = false

          for allocation in option_variant.selling_plan_allocations
            assign allocation_plan_id = allocation.selling_plan.id | append: ''
            if fixed_selling_plan_id != blank
              if allocation_plan_id == fixed_selling_plan_id
                assign has_real_allocation = true
                assign subscription_price = allocation.price
                assign first_selling_plan_id = allocation.selling_plan.id
                break
              endif
            else
              assign has_real_allocation = true
              assign subscription_price = allocation.price
              assign first_selling_plan_id = allocation.selling_plan.id
              break
            endif
          endfor

          if has_real_allocation == false and option_variant.selling_plan_allocations.size > 0 and fixed_selling_plan_id != blank
            for allocation in option_variant.selling_plan_allocations
              assign has_real_allocation = true
              assign subscription_price = allocation.price
              assign first_selling_plan_id = allocation.selling_plan.id
              break
            endfor
          endif

          if has_real_allocation == false and fixed_selling_plan_id != blank
            assign discount_multiplier = 100 | minus: dummy_subscription_percent
            assign subscription_price = option_price | times: discount_multiplier | divided_by: 100
          elsif has_real_allocation == false and dummy_subscription_enabled
            assign discount_multiplier = 100 | minus: dummy_subscription_percent
            assign subscription_price = option_price | times: discount_multiplier | divided_by: 100
          endif

          assign per_bottle_subscription = subscription_price | plus: bottle_half | divided_by: bottle_count

          assign save_one_time_label = save_badge
          assign save_subscription_label = save_badge
          if option_compare > option_price and option_compare > 0
            assign one_time_diff = option_compare | minus: option_price
            assign save_percent_one_time = one_time_diff | times: 100 | divided_by: option_compare
            if save_one_time_label == blank
              assign save_one_time_label = 'Save ' | append: save_percent_one_time | append: '%'
            endif
          endif
          if option_compare > subscription_price and option_compare > 0
            assign subscription_diff = option_compare | minus: subscription_price
            assign save_percent_subscription = subscription_diff | times: 100 | divided_by: option_compare
            assign save_subscription_label = 'Save ' | append: save_percent_subscription | append: '%'
          endif

          assign is_default = false
          if i == default_option
            assign is_default = true
          endif
        -%}

        <div class="product-bundle-picker__option-wrap{% if customer_banner != blank %} product-bundle-picker__option-wrap--banner{% endif %} {% if show_best_value %}show_best_value{% endif %}">
      

          <label class="product-bundle-picker__option{% if is_default %} is-selected{% endif %}">
            {%- if customer_banner != blank -%}
              <div class="product-bundle-picker__customer-banner">{{ customer_banner | escape }}</div>
            {%- endif -%}
            <input
              type="radio"
              name="bundle-variant-{{ section.id }}"
              value="{{ option_variant.id }}"
              class="product-bundle-picker__input visually-hidden"
              data-price="{{ option_price | money | strip_html }}"
              data-compare-at="{% if option_compare > option_price %}{{ option_compare | money | strip_html }}{% endif %}"
              data-subscription-price="{{ subscription_price | money | strip_html }}"
              data-price-cents="{{ option_price }}"
              data-subscription-price-cents="{{ subscription_price }}"
              data-selling-plan-id="{{ first_selling_plan_id }}"
              data-has-selling-plan="{% if has_real_allocation %}true{% else %}false{% endif %}"
              data-per-bottle="{{ per_bottle_price | money | strip_html }}"
              data-per-bottle-subscription="{{ per_bottle_subscription | money | strip_html }}"
              {% if is_default %}checked{% endif %}
              {% if option_variant.available == false %}disabled{% endif %}
            >

            {%- if show_best_value -%}
              <span class="product-bundle-picker__best-value">{{ block.settings.best_value_label | escape }}</span>
            {%- endif -%}

            <span class="product-bundle-picker__media">
              {%- if block.settings[image_key] != blank -%}
                {{
                  block.settings[image_key]
                  | image_url: width: 240
                  | image_tag:
                    class: 'product-bundle-picker__image',
                    loading: 'lazy',
                    widths: '80, 120, 160, 240',
                    alt: option_title
                }}
              {%- elsif option_variant.featured_image and option_variant.metafields.custom.variant_custom_image == blank -%}
                {{
                  option_variant.featured_image
                  | image_url: width: 240
                  | image_tag:
                    class: 'product-bundle-picker__image',
                    loading: 'lazy',
                    widths: '80, 120, 160, 240',
                    alt: option_title
                }}
              {%- elsif option_variant.metafields.custom.variant_custom_image != blank -%}
                {{
                  option_variant.metafields.custom.variant_custom_image
                  | image_url: width: 240
                  | image_tag:
                    class: 'product-bundle-picker__image',
                    loading: 'lazy',
                    widths: '80, 120, 160, 240',
                    alt: option_title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-bundle-picker__image product-bundle-picker__placeholder' }}
              {%- endif -%}

              {%- if save_one_time_label != blank -%}
                <span
                  class="product-bundle-picker__save-badge"
                  data-bundle-save-badge
                  data-save-one-time="{{ save_one_time_label | escape }}"
                  data-save-subscription="{{ save_subscription_label | escape }}"
                >
                  {{- save_one_time_label | escape -}}
                </span>
              {%- endif -%}
            </span>

            <div class="product-bundle-picker__content">
              <p class="product-bundle-picker__title">
                {{ option_title | escape }}
                {%- if highlight_text != blank -%}
                  <span class="product-bundle-picker__highlight"> {{ highlight_text | escape }}</span>
                {%- endif -%}
              </p>
              <span class="product-bundle-picker__per-bottle">
                <span data-bundle-per-bottle-price>{{ per_bottle_price | money }}</span> {{ block.settings.per_bottle_suffix | escape }}
              </span>
            </div>

            <span class="product-bundle-picker__pricing">
              <span class="product-bundle-picker__price" data-bundle-price>{{ option_price | money }}</span>
              {%- if option_compare > option_price -%}
                <span class="product-bundle-picker__compare" data-bundle-compare>{{ option_variant.compare_at_price | money }}</span>
              {%- endif -%}
            </span>
          </label>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <script type="application/json">
    {{ product.variants | json }}
  </script>
</bundle-variant-picker>
