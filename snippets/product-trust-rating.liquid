{% comment %}
  Renders a trust rating badge with stars and review text.

  Accepts:
  - block: {Object} Block object with trust_rating settings

  Usage:
  {% render 'product-trust-rating', block: block %}
{% endcomment %}

<div
  class="product-trust-rating"
  style="--trust-rating-star-color: {{ block.settings.star_color }};"
>
  <div class="product-trust-rating__stars" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 20 19" fill="none">
        <path d="M9.99196 0L12.3507 7.25955H19.9839L13.8085 11.7462L16.1673 19.0058L9.99196 14.5191L3.81662 19.0058L6.17539 11.7462L4.57764e-05 7.25955H7.63319L9.99196 0Z" fill="#F79D0D"/>
      </svg>
    {%- endfor -%}
  </div>
  <p class="product-trust-rating__text">
    {{ block.settings.rating_prefix | escape }}
    {{ ' ' }}
    {{ block.settings.rating_score | escape }}
    {{ ' ' }}
    ‘<strong>{{ block.settings.rating_label | escape }}</strong>’
    {%- if block.settings.customer_count != blank -%}
      <span class="product-trust-rating__separator">|</span>
      {{- block.settings.customer_count | escape -}}
    {%- endif -%}
  </p>
</div>
