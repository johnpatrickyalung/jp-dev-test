{% comment %}
  Renders a product info list icon.

  Accepts:
  - icon: {String} Icon key
  - custom_icon: {Object} Image object
  - in_stock: {Boolean} For stock_dot state

  Usage:
  {% render 'product-info-icon', icon: 'shipping', in_stock: true %}
{% endcomment %}

{%- if custom_icon != blank -%}
  {{
    custom_icon
    | image_url: width: 44
    | image_tag:
      class: 'product-info-list__custom-icon',
      loading: 'lazy',
      widths: '22, 44',
      alt: ''
  }}
{%- elsif icon == 'stock_dot' -%}
  <span
    class="product-info-list__stock-dot{% if in_stock %} product-info-list__stock-dot--in-stock{% else %} product-info-list__stock-dot--out-of-stock{% endif %}"
    aria-hidden="true"
  ></span>
{%- elsif icon == 'shipping' -%}
  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="19" height="19" viewBox="0 0 19 19" fill="none">
    <rect width="18.2" height="18.2" fill="url(#pattern0_37_158)"/>
    <defs>
    <pattern id="pattern0_37_158" patternContentUnits="objectBoundingBox" width="1" height="1">
    <use xlink:href="#image0_37_158" transform="scale(0.00195312)"/>
    </pattern>
    <image id="image0_37_158" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
    </defs>
    </svg>
{%- elsif icon == 'shield' -%}
  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="19" height="19" viewBox="0 0 19 19" fill="none">
    <rect width="18.2" height="18.2" fill="url(#pattern0_37_168)"/>
    <defs>
    <pattern id="pattern0_37_168" patternContentUnits="objectBoundingBox" width="1" height="1">
    <use xlink:href="#image0_37_168" transform="scale(0.00195312)"/>
    </pattern>
    <image id="image0_37_168" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
    </defs>
    </svg>
{%- elsif icon == 'info' -%}
